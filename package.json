{
  "name": "word-studio-pro",
  "version": "1.0.0",
  "description": "Desktop-Grade Rich Text & Document Processor (.DOCX, .DOC, .PDF) for Android Tablets, Foldables & Desktop",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "cap:sync": "npx cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  },
  "license": "MIT"
}
